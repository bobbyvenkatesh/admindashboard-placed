{
  "version": 2,
  "name": "placed-admin-intelligence",
  "cleanUrls": true,
  "builds": [
    {
      "src": "*",
      "use": "@vercel/static"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
